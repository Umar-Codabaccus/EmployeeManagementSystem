@model EmployeeManagementSystem.ViewModels.ManagerViewModels.CreateSpecificationVM

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE-edge">
    <title>Create Specification</title>
    <link rel="stylesheet" href="~/css/responsive.css"/>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9; /* Soft background similar to login */
            margin: 0;
            padding: 0;
            color: #333; /* Neutral text color */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh; /* Full height for centered form */
        }

        /* Card styling for the form */
        .card {
            background-color: white;
            padding: 25px 30px;
            border-radius: 8px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1); /* Enhanced shadow for modern feel */
            max-width: 500px; /* Slightly wider form */
            width: 100%;
            text-align: center; /* Center align form elements */
            margin: 0 15px; /* Add margin on smaller screens */
        }

        /* Header inside the card */
        .card h2 {
            color: #0056b3; /* Blue color for header */
            font-size: 24px;
            margin-bottom: 20px;
        }

        /* Form labels */
        label {
            font-size: 14px;
            font-weight: bold;
            color: #333; /* Darker text for labels */
            margin-bottom: 8px;
            display: block;
            text-align: left;
        }

        /* Input field styling */
        input[type="text"], input[type="email"], input[type="number"], input[type="date"], select {
            width: 100%; /* Full width of the input fields */
            padding: 10px;
            margin: 10px 0 20px 0; /* Add spacing between fields */
            border: 1px solid #ccc; /* Light border */
            border-radius: 4px;
            font-size: 14px;
            box-sizing: border-box; /* Ensure padding doesn't affect width */
        }

        /* Button styling */
        button {
            background-color: #0056b3; /* Blue background */
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.3s ease;
            width: 100%; /* Full width button */
            margin-top: 15px; /* Spacing from inputs */
        }

        /* Button hover effect */
        button:hover {
            background-color: #003d80; /* Darker blue on hover */
        }


        /* Error message styling */
        .error {
            color: red;
            font-size: 14px;
            margin-bottom: 10px;
        }

        /* Success message styling */
        p {
            font-size: 14px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <form asp-controller="Manager" asp-action="CreateSpecification" method="post" class="card">
        <h2>Create Specification</h2>

        @if (ViewBag.Error != null)
        {
            <p style="color: green;">@ViewBag.Error</p>
        }
        <div id="descriptionError" class="error" style="display: none; color: red;">
            Special characters are not allowed in description.
        </div>
        <label>Description</label>
        <input asp-for="@Model.Description" type="text" id="description" name="description" oninput="checkSpecialCharacters(event)" />

        <label>Deadline</label>
        @Html.TextBoxFor(m => m.Deadline, new { type = "date", min = DateTime.Now.ToString("yyyy-MM-dd") })

        <input asp-for="@Model.Keyword" type="text" id="keyword" name="keyword" placeholder="Search Employee...">

        <!-- Submit and Back Buttons -->
        <button class="form-btn" type="submit" name="create-btn" value="add">Create</button>
    </form>

    <script>
        // Function to check for special characters in the input
        function checkSpecialCharacters(event) {
            const inputField = event.target; // Get the field that triggered the event
            const errorMessageId = inputField.id + "Error"; // Dynamically create error message ID
            const errorMessage = document.getElementById(errorMessageId);

            // Regular expression to detect special characters
            const specialCharRegex = /[^a-zA-Z0-9\s]/;

            // Validate input and toggle error message visibility
            if (specialCharRegex.test(inputField.value)) {
                errorMessage.style.display = "block"; // Show error message
            } else {
                errorMessage.style.display = "none"; // Hide error message
            }
        }
    </script>
</body>
</html>
