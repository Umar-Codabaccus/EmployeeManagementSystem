@model EmployeeManagementSystem.ViewModels.AdminDashboardViewModel
@using Newtonsoft.Json

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE-edge">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css"/>

    <style>
        /* Buttons */
        .header .button {
            background-color: #0056b3; /* Match the header/nav color */
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .header .button:hover {
            background-color: #003d80; /* Darker blue on hover */
        }
    </style>
</head>

<body>
    <header>
        <div class="title">        
                <h3>code no jutsu</h3>
        </div>
    </header>

    <div class="main-container">
        <div class="navcontainer">
            <nav class="nav">
                <form asp-controller="Admin" asp-action="AdminDashboard" method="post">
                    <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
                    <ul>
                        <li><button class="nav-btn" type="submit" name="navOption" value="dashboard">Dashboard</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="department">Departments</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="team">Teams</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="position">Positions</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="employee">Employees</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="management">Management</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="profile">Profile</button></li>
                        <li><button class="nav-btn" type="submit" name="navOption" value="logout">Logout</button></li>
                    </ul>
                </form>
            </nav>
        </div>
    </div>

    <div class="main">
        <div class="box-container">
            <div class="box1">
                <div class="polarchart">
                    <canvas id="myChart"></canvas>
                </div>

                @{
                    // Serialize the data for Chart.js
                    var teamNames = JsonConvert.SerializeObject(Model.PolarChart.Select(p => p.TeamName));
                    var employeeCounts = JsonConvert.SerializeObject(Model.PolarChart.Select(p => p.NumEmployees));
                }

                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    const teamNames = @Html.Raw(teamNames);
                    const employeeCounts = @Html.Raw(employeeCounts);

                    function generateColors(count) {
                        const colors = [];
                        for (let i = 0; i < count; i++) {
                            const r = Math.floor(Math.random() * 256); // Random red value
                            const g = Math.floor(Math.random() * 256); // Random green value
                            const b = Math.floor(Math.random() * 256); // Random blue value
                            colors.push(`rgb(${r}, ${g}, ${b})`); // Add the color to the array
                        }
                        return colors;
                    }

                    const colors = generateColors(teamNames.length);

                    const ctx = document.getElementById('myChart');
                    new Chart(ctx, {
                        type: 'polarArea',
                        data: {
                            labels: teamNames,
                            datasets: [{
                                label: 'Employees Per Team',
                                data: employeeCounts,
                                backgroundColor: colors
                            }]
                        },
                        options: {}
                    });
                </script>
            </div>

            <div class="box2">
                <div class="barchart">
                    <canvas id="myChart2"></canvas>
                </div>

                @{
                    // Serialize the data for Chart.js
                    var departmentNames = JsonConvert.SerializeObject(Model.BarChart.Select(b => b.DepartmentName));
                    var teamCounts = JsonConvert.SerializeObject(Model.BarChart.Select(b => b.NumTeams));
                }

                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    const departmentNames = @Html.Raw(departmentNames);
                    const teamCounts = @Html.Raw(teamCounts);

                    const ctx2 = document.getElementById('myChart2');

                    new Chart(ctx2, {
                        type: 'bar',
                        data: {
                            labels: departmentNames,
                            datasets: [{
                                label: 'Number of Teams',
                                data: teamCounts,
                                borderWidth: 1
                            }]
                        },
                        options: {
                            scales: {
                                y: {
                                    beginAtZero: true
                                }
                            }
                        }
                    });
                </script>
            </div>
        </div>

        <div class="container">
            <div class="header">
                <h1 class="recent">Projects</h1>
                <button class="button">View All</button>
            </div>

            <div class="body">
                <div class="topic-heading">
                    <h3 class="t-op">Project</h3>
                    <h3 class="t-op">Team</h3>
                    <h3 class="t-op">Deadline</h3>
                    <h3 class="t-op">Status</h3>
                </div>

                <div class="items">
                    <div class="item1">
                        @foreach (var project in Model.Projects)
                        {
                            <h3 class="t-op-nextlvl">@project.ProjectName</h3>
                            <h3 class="t-op-nextlvl">@project.TeamName</h3>
                            <h3 class="t-op-nextlvl">@project.Deadline.ToString("yyyy/MM/dd")</h3>
                            <h3 class="t-op-nextlvl label-tag">@project.Status</h3>
                        }
                    </div>
                </div>
            </div>
        </div>

     </div>
</body>

</html>