@model EmployeeManagementSystem.Models.Login

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE-edge">
    <title>Login Page</title>
    <link rel="stylesheet" href="~/css/login.css"/>
</head>
<body>
    <div class="container">
        <h2>Code No Jutsu</h2>

        @if (ViewBag.Error)
        {
            <h6 style="color:red;">username and password should be entered</h6>
        }

        @if (ViewBag.Loginfailed)
        {
            <h6 style="color:red;">username or password invalid</h6>
        }

        <form asp-controller="Login" asp-action="login" method="post">
            <label>Username</label>
            <input asp-for="@Model.Username" type="text" name="username"/>

            <label>Password</label>
            <input asp-for="@Model.Password" type="password" name="password"/>

            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>
