@model EmployeeManagementSystem.ViewModels.DeleteDepartmentViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE-edge">
    <title>Delete Department</title>
    <link rel="stylesheet" href="~/css/delete_department.css" />

    <style>
        a {
            display: inline-block; /* Makes the link behave like a button */
            background-color: #e7e7e7; /* Light gray background */
            color: #333; /* Neutral text color */
            text-decoration: none; /* Remove underline */
            padding: 10px 20px; /* Spacing inside the link */
            margin-top: 10px; /* Space above the link */
            border-radius: 4px; /* Rounded corners */
            font-size: 14px;
            transition: background-color 0.3s ease;
            text-align: center;
            width: auto;
        }

            a:hover {
                background-color: #d6d6d6; /* Darker gray on hover */
            }

        button, a {
            display: inline-block; /* Place buttons and links on the same line */
            margin-right: 10px; /* Add spacing between buttons and links */
        }
    </style>
</head>
<body>
    <form asp-controller="Admin" asp-action="DeleteDepartment" method="post" class="card">
        <label for="departments">Select Department to Delete:</label>

        <!-- Display error message if no selection is made -->
        @if (ViewBag.Error)
        {
            <div class="error">
                <p style="color: red;">Please select a department to delete</p>
            </div>
        }

        <!-- Display success message if a department is deleted -->
        @if (ViewBag.Success)
        {
            <div class="success">
                <p style="color: green;">Department was successfully deleted</p>
            </div>
        }

        <select asp-for="DepartmentId" name="DepartmentID" asp-items="@Model.Departments">
            <option>Please select one</option>

            @foreach (var items in Model.DepartmentList)
            {
                <option value="@items.DepartmentID">@items.DepartmentName</option>
            }
        </select>
        <button type="submit">Delete</button>
        <a href="Department">Back</a>
    </form>
</body>
</html>

